{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mira.local/schemas/flowchart.schema.json",
  "title": "Mira structured contest-paper flowchart",
  "type": "object",
  "required": ["version", "diagram_id", "title", "claim_ids", "lanes", "nodes", "edges"],
  "properties": {
    "version": {"const": 1},
    "diagram_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "title": {"type": "string", "minLength": 4},
    "paper_section": {"type": "string"},
    "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "orientation": {"enum": ["left_to_right", "top_to_bottom"]},
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "order"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "label", "lane", "role", "claim_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 2},
          "lane": {"type": "string", "minLength": 1},
          "role": {"enum": ["input", "method", "shared", "decision", "output", "validation"]},
          "level": {"type": "integer", "minimum": 0},
          "group": {"type": "string"},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "kind": {"enum": ["main", "validation", "feedback", "dependency"]}
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "node_width": {"type": "number", "minimum": 1.4, "maximum": 3.5},
        "node_height": {"type": "number", "minimum": 0.6, "maximum": 1.8},
        "level_gap": {"type": "number", "minimum": 0.7, "maximum": 3.0},
        "lane_height": {"type": "number", "minimum": 1.6, "maximum": 4.5},
        "lane_width": {"type": "number", "minimum": 2.2, "maximum": 4.5}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
